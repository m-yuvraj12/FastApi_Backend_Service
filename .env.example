# --- Postgres (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notifications

# --- JWT ---  generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Firebase Cloud Messaging ---
# Service-account JSON downloaded from Firebase console; place it at secrets/firebase-service-account.json
FCM_DRY_RUN=false

# --- Only for running WITHOUT docker-compose (local uvicorn) ---
# DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/notifications
# FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
